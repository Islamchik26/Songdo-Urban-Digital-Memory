# Copy to .env and adjust. .env is git-ignored.
DB_HOST=127.0.0.1
# Default PostgreSQL port is 5432. Check yours in pgAdmin (server -> Properties -> Connection).
DB_PORT=5432
DB_NAME=songdo_urban_memory
DB_USER=songdo_admin
DB_PASSWORD=songdo_local

# Token required in the X-API-Token header by ingestion (write) endpoints
INGEST_API_TOKEN=songdo-dev-token

# Songdo Teaching Bounding Box (WGS84). Must match core.is_in_songdo() in sql/01_core_schema.sql
SONGDO_MIN_LON=126.600
SONGDO_MAX_LON=126.685
SONGDO_MIN_LAT=37.350
SONGDO_MAX_LAT=37.425

# Optional: data.go.kr key for scripts/ingest_airkorea.py (live AirKorea data). Never commit the real key.
AIRKOREA_API_KEY=
